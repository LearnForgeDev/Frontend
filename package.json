{
  "name": "learn-forge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "YENV=development vite --host",
    "dev:tunnel": "sh -c '. ./.env && ssh -f -i \"$VITE_SSH_PASSKEY_PATH\" -N -L 8443:127.0.0.1:443 -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \"$VITE_SSH_USER\"' && pnpm run dev",
    "build": "YENV=production tsc -b && YENV=production vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "YENV=production vite preview",
    "deploy": "YENV=production npm run build && gh-pages -d dist",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@lexical/file": "^0.39.0",
    "@lexical/react": "^0.39.0",
    "@microsoft/signalr": "^8.0.7",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.18.1",
    "calendar-link": "^2.11.4",
    "desmos": "^1.5.4",
    "install": "^0.13.0",
    "katex": "^0.16.27",
    "lexical": "^0.39.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "react-spinners": "^0.17.0",
    "react-use": "^17.6.0",
    "qrcode.react": "^4.2.0",
    "spark-md5": "^3.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.2",
    "@types/desmos": "^1.11.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-react": "^5.1.1",
    "a": "^4.0.0",
    "babel-loader": "^10.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.8"
  }
}
